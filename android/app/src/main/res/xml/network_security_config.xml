<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- İnternet radyolarının çoğu hâlâ http akışı kullanıyor. Dinleyebilmek
         için düz metin akışlara izin verilir; kontrol/API çağrıları HTTPS. -->
    <base-config cleartextTrafficPermitted="true" />
    <!-- http davet bağlantısı da aynı host üzerinden sorunsuz açılsın. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">cloudtune.app</domain>
    </domain-config>
</network-security-config>
