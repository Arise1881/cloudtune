[Unit]
Description=Melody stream proxy (yt-dlp po_token cozucu)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=msi
WorkingDirectory=/home/msi/Belgeler/Default Project/sonora/melody-proxy
Environment=YTDLP_PATH=/home/msi/Belgeler/Default Project/sonora/melody-proxy/venv/bin/yt-dlp
Environment=MELODY_PORT=8800
ExecStart=/home/msi/Belgeler/Default Project/sonora/melody-proxy/venv/bin/python /home/msi/Belgeler/Default Project/sonora/melody-proxy/server.py --port 8800
Restart=always
RestartSec=5
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target